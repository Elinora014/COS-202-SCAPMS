	$(COPY_FILE) --parents ../model/PatientRecord.cpp ../model/GeneralPatient.cpp ../model/EmergencyPatient.cpp ../model/FollowUpPatient.cpp ../model/Appointment.cpp ../model/ClinicDatabase.cpp ../controller/SearchEngine.cpp ../controller/ClinicManager.cpp ../controller/AppointmentController.cpp ../utils/IDGenerator.cpp ../utils/FileHandler.cpp ../gui/MainWindow.cpp ../gui/PatientPanel.cpp ../gui/AppointmentPanel.cpp ../gui/QueuePanel.cpp ../gui/SearchSortPanel.cpp ../gui/AdminPanel.cpp ../main.cpp $(DISTDIR)/


