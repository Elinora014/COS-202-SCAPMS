    PatientRecord <|-- FollowUpPatient

    %% Polymorphism: PatientRecord holds vector of linked Appointment IDs (composition)
    PatientRecord "1" *-- "many" Appointment : appointmentIds_

    %% ClinicDatabase owns patients (composition via unique_ptr)
    ClinicDatabase "1" *-- "many" PatientRecord : patients_
    ClinicDatabase "1" -- "many" Appointment : appointments_

    %% ClinicManager uses ClinicDatabase
    ClinicManager "1" *-- "1" ClinicDatabase : db_

    %% ClinicManager uses SearchEngine (static calls)
    ClinicManager ..> SearchEngine : sort/search calls

    %% AppointmentController uses ClinicManager
    AppointmentController ..> ClinicManager : manager_

    %% GUI panels reference controllers
    MainWindow ..> ClinicManager : manager_
    MainWindow ..> AppointmentController : appointments_
    PatientPanel ..> ClinicManager : manager_
    AppointmentPanel ..> ClinicManager : manager_
    AppointmentPanel ..> AppointmentController : controller_
    QueuePanel ..> ClinicManager : manager_
    SearchSortPanel ..> ClinicManager : manager_
    AdminPanel ..> ClinicManager : manager_

    %% MainWindow owns all panels (aggregation/composition via Qt parent-child)
    MainWindow "1" o-- "5" PatientPanel : tabs
    MainWindow "1" o-- "5" AppointmentPanel : tabs
